# Standalone Memories server configuration
DATABASE_URL=

# Replit secret containing the Google Drive root folder ID for:
# 相片簿/20260620 我們結婚了
MEMORIES_DRIVE_PHOTOS_FOLDER_ID=

# Administrator password used only by /Memories/admin/login to create a
# short-lived HttpOnly session. The exact secret name is required.
MEMORIES_ADMIN_TOKEN=

# Optional; defaults to five minutes and never runs more often than one minute.
MEMORIES_DRIVE_SYNC_INTERVAL_MS=300000

# Optional thumbnail backfill tuning.
MEMORIES_THUMBNAIL_BATCH_SIZE=12
MEMORIES_THUMBNAIL_MAX_PER_RUN=240

# Legacy optional override. The runtime normally discovers or creates 系統縮圖
# under the configured root folder, so this stays empty in normal deployments.
MEMORIES_DRIVE_THUMBNAILS_FOLDER_ID=
