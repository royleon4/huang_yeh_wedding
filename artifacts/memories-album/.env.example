# Standalone Memories server configuration
DATABASE_URL=

# Replit secret containing the Google Drive root folder ID for:
# 相片簿/20260620 我們結婚了
MEMORIES_DRIVE_PHOTOS_FOLDER_ID=

# Password used only by /admin/login to create a short-lived HttpOnly session.
SECRET_TOKEN=

# Optional; defaults to five minutes and never runs more often than one minute.
MEMORIES_DRIVE_SYNC_INTERVAL_MS=300000

# Legacy optional override. The runtime now discovers/creates 系統縮圖
# under the configured root folder, so this normally stays empty.
MEMORIES_DRIVE_THUMBNAILS_FOLDER_ID=
