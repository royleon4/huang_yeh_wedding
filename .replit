modules = ["nodejs-24", "python-base-3.13"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[[artifacts]]
id = "artifacts/memories-album"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "artifacts/memories-album: memories"

[[workflows.workflow]]
name = "artifacts/memories-album: memories"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/memories-album"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/memories-album run dev"
cwd = "./artifacts/memories-album"
waitForPort = 19316
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "19316"
MEMORIES_BASE_PATH = "/Memories"

[[workflows.workflow]]
name = "artifacts/wedding-invitation: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/wedding-invitation"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/wedding-invitation run dev"
cwd = "./artifacts/wedding-invitation"
waitForPort = 19315
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "19315"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8080"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-sheet:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[objectStorage]
defaultBucketID = "replit-objstore-9709936d-1776-4923-b6e3-ed86b63197b7"

[nix]
channel = "stable-25_05"
packages = ["u-root-cmds"]
